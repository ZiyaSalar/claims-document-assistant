# Document storage backend: local or azure
STORAGE_BACKEND=local

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=<azure-blob-storage-connection-string>
AZURE_STORAGE_CONTAINER=claim-documents

# Database backend: memory or azure
DB_BACKEND=memory / azure

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=claims-assistant-db
AZURE_SQL_USERNAME=your-sql-admin-username
AZURE_SQL_PASSWORD=